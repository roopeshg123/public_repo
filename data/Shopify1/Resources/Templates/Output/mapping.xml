<Items>
    <OrderLineItemTaxLines table="`OrderLineItemTaxLines`" allColumns="true" selectQuery="SELECT * FROM `OrderLineItemTaxLines` WHERE `Title` = 'GST'">
        <ResourceId key="true" />
        <Title key="true" />
        <ChannelLiable type="boolean" />
        <PriceSetPresentmentMoneyAmount type="decimal" />
        <PriceSetPresentmentMoneyCurrencyCode />
        <PriceSetShopMoneyAmount type="decimal" />
        <PriceSetShopMoneyCurrencyCode />
        <Rate type="double" />
        <RatePercentage type="double" />
        <Source />
    </OrderLineItemTaxLines>
</Items>