<!--
NOTE: The following attributes can be included in the table XML:
selectQuery="SELECT * FROM XXX" - This can be used to specify a custom query to execute for this mapping.
skipProcessedRows="true" - When true, the application will only process rows one time.
-->

<Items>
    <runFirst table="updateTable" insertQuery="TRUNCATE TABLE [dbo].[Orders]" requireInput="false"/>
    <Orders table="`dbo`.`Orders`" allColumns="true" selectQuery="SELECT * FROM `dbo`.`Orders`">
        <OrderID type="integer" key="true" />
        <CreatedDate type="datetime" />
        <CustomerID type="integer" />
        <DeliveryDate type="datetime" />
        <OrderDate type="datetime" />
        <OrderNumber />
        <OrderStatus />
        <PaymentMethod />
        <Remarks />
        <ShippingAddress />
        <ShippingCity />
        <ShippingDate type="datetime" />
        <ShippingPostalCode />
        <TotalAmount type="decimal" />
    </Orders>
</Items>